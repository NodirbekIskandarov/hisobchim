# --- Majburiy ---
TELEGRAM_TOKEN=bu_yerga_botfather_bergan_token
ANTHROPIC_API_KEY=sk-ant-...

# Botga /id yozib olingan raqamni shu yerga qo'ying.
# Bir nechta bo'lsa vergul bilan: 123456789,987654321
ALLOWED_USER_IDS=123456789

# --- Ixtiyoriy ---
PARSE_MODEL=claude-haiku-4-5-20251001
CHAT_MODEL=claude-sonnet-5
# Chek rasmini o'qiydigan model. Arzonroq variant: claude-sonnet-5
VISION_MODEL=claude-opus-5
DB_PATH=hisobchi.db
CURRENCY=so'm
TIMEZONE=Asia/Tashkent

# "obedga 50" -> 50 000 so'm deb tushunilsinmi?
SMALL_NUMBERS_ARE_THOUSANDS=true

# Savolga javob berishda AI ko'radigan maksimal yozuvlar soni
QA_MAX_ROWS=500

# Bitta chek uchun maksimal rasm soni (uzun chekni bo'lib yuborish uchun)
MAX_RECEIPT_PARTS=8
# Bitta rasm uchun maksimal hajm (bayt)
MAX_IMAGE_BYTES=4500000
