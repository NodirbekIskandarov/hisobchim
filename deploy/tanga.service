[Unit]
Description=Tanga Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tanga
Group=tanga
WorkingDirectory=/opt/tanga
EnvironmentFile=/opt/tanga/.env
ExecStart=/opt/tanga/.venv/bin/python /opt/tanga/bot.py
Restart=always
RestartSec=10

# Loglar journald'ga tushadi: journalctl -u tanga -f
StandardOutput=journal
StandardError=journal

# Xavfsizlik cheklovlari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tanga

[Install]
WantedBy=multi-user.target
